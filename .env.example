# Copy to .env and fill in. Generate secrets with: openssl rand -hex 32

# Neon: Dashboard -> Connect. Use the DIRECT host (no "-pooler" in it): Debezium's
# replication connection and Flyway's locks don't work through PgBouncer.
DB_HOST=ep-xxxxx-xxxxxxxx.us-east-2.aws.neon.tech
DB_PORT=5432
DB_SSLMODE=require
DB_USERNAME=neondb_owner
DB_PASSWORD=

PAYMENT_WEBHOOK_SECRET=

# Optional: phone of an existing account to promote to ADMIN at startup.
BOOTSTRAP_ADMIN_PHONE=

# RSA key that signs JWTs (base64 PKCS#8, one line). Generate:
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 | openssl pkcs8 -topk8 -nocrypt -outform DER | base64
JWT_PRIVATE_KEY=
